{
  "name": "dsh-whale-workbench",
  "version": "1.1.0",
  "description": "鲸鱼待办：日历 + 待办 + AI 智能规划 + 提醒 + Agent 工具，全部数据留在本机",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "workbench-core",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSES"
  ],
  "engines": {
    "dsh": ">=0.1.7",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-approval",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "calendar",
    "todo",
    "task",
    "workbench"
  ],
  "license": "MIT",
  "private": true
}
